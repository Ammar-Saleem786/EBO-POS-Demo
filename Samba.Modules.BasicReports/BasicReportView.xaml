<UserControl x:Class="Samba.Modules.BasicReports.BasicReportView" x:Name="CenterRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:reports="clr-namespace:Samba.Modules.BasicReports">
 <Grid Margin="14" Background="#F1F5F9">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <TextBlock Text="Report Center" FontSize="28" FontWeight="SemiBold" Foreground="#164E63"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <TextBlock Text="Zoom" Margin="12,8"/><Slider Width="130" Minimum="60" Maximum="180" Value="{Binding ReportZoom}" TickFrequency="10" IsSnapToTickEnabled="True"/>
    <Button Content="Save my view" Command="{Binding SavePreferencesCommand}" Margin="10,0" Padding="12,6"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0" Padding="12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Find a report" Foreground="#475569" Margin="0,0,0,6"/>
      <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8"/>
      <CheckBox Content="Favorites only" IsChecked="{Binding FavoritesOnly}" Margin="0,12"/>
      <Button Content="{Binding FavoriteLabel}" Command="{Binding FavoriteCommand}" Padding="8" Margin="0,0,0,12"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Reports}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button CommandParameter="{Binding}" Command="{Binding DataContext.ReportExecuteCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
         Background="{Binding Background}" Foreground="{Binding Foreground}" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,3">
         <TextBlock Text="{Binding Header}" TextWrapping="Wrap" FontSize="16"/>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <TextBlock Text="Choose a report from the list. Use its period/date filters, then Refresh. Add favorites to customize your list."
     TextWrapping="Wrap" Foreground="#64748B" FontSize="20" Margin="30" VerticalAlignment="Center"/>
    <reports:ReportView Background="#F1F5F9" DataContext="{Binding ActiveReport}" Tag="{Binding DataContext.ReportZoom,ElementName=CenterRoot}"
     Visibility="{Binding DataContext.IsReportVisible,ElementName=CenterRoot,Converter={StaticResource VisibilityConverter}}"/>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding PreferenceStatus}" Foreground="#64748B" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
