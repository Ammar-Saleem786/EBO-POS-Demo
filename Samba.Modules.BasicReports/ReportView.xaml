<UserControl x:Class="Samba.Modules.BasicReports.ReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,10">
   <StackPanel>
    <ItemsControl ItemsSource="{Binding FilterGroups}" IsEnabled="{Binding CanUserChangeDates}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><ComboBox FontSize="15" Margin="3" MaxWidth="260" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue,Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel>
     <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanUserChangeDates}">
      <TextBlock Text="From" VerticalAlignment="Center" Margin="4"/><TextBox ToolTip="Day month year, for example 06 11 2026" Margin="3" FontSize="15" Width="112" Text="{Binding StartDateString,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
      <TextBlock Text="To" VerticalAlignment="Center" Margin="4"/><TextBox ToolTip="End boundary is exclusive for completed date ranges" Margin="3" FontSize="15" Width="112" Text="{Binding EndDateString,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
     </StackPanel>
     <Button Margin="3" Padding="10,6" Content="Refresh" Command="{Binding RefreshFiltersCommand}"/>
     <Button Margin="3" Padding="10,6" Content="Preview" Command="{Binding PreviewCommand}"/>
     <Button Margin="3" Padding="10,6" Content="Print" Command="{Binding PrintDocumentCommand}"/>
     <Button Margin="3" Padding="10,6" Content="Save XPS" Command="{Binding SaveDocumentCommand}"/>
     <Button Margin="3" Padding="10,6" Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <FlowDocumentScrollViewer Grid.Row="1" Background="White" Zoom="{Binding Tag,RelativeSource={RelativeSource AncestorType=UserControl}}" MinZoom="60" MaxZoom="180" Document="{Binding Document}"/>
 </Grid>
</UserControl>
