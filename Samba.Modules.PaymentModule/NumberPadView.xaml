<UserControl x:Class="Samba.Modules.PaymentModule.NumberPadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:FxButton="clr-namespace:FlexButton;assembly=FlexButton" mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Grid.Row="1" MaxHeight="360" MaxWidth="560" VerticalAlignment="Top" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*" />
            <ColumnDefinition Width="56*" />
            <ColumnDefinition Width="17*" />
        </Grid.ColumnDefinitions>

        <ItemsControl Grid.Column="0" ItemsSource="{Binding PaymentScreenValues}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <FxButton:FlexButton Style="{StaticResource EboTouch}" ButtonColor="#CCFBF1" Content="{Binding Path=.}" CommandParameter="{Binding Path=.}" Margin="4"
                        Command="{Binding DataContext.SetValueCommand,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ItemsControl}}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!--<UniformGrid Grid.Column="0" Rows="6">
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="1" Margin="4"
                         ButtonColor="#CCFBF1">1</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="5" Margin="4"
                         ButtonColor="#CCFBF1">5</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="10" Margin="4"
                         ButtonColor="#CCFBF1">10</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="20" Margin="4"
                         ButtonColor="#CCFBF1">20</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="50" Margin="4"
                         ButtonColor="#CCFBF1">50</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="100" Margin="4"
                         ButtonColor="#CCFBF1">100</FxButton:FlexButton>
        </UniformGrid>-->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="0" Grid.Row="0" Command="{Binding TypeValueCommand}"
                         CommandParameter="1" Margin="4">1</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="1" Grid.Row="0" Command="{Binding TypeValueCommand}"
                         CommandParameter="2" Margin="4">2</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="2" Grid.Row="0" Command="{Binding TypeValueCommand}"
                         CommandParameter="3" Margin="4">3</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="0" Grid.Row="1" Command="{Binding TypeValueCommand}"
                         CommandParameter="4" Margin="4">4</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="1" Grid.Row="1" Command="{Binding TypeValueCommand}"
                         CommandParameter="5" Margin="4">5</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="2" Grid.Row="1" Command="{Binding TypeValueCommand}"
                         CommandParameter="6" Margin="4">6</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="0" Grid.Row="2" Command="{Binding TypeValueCommand}"
                         CommandParameter="7" Margin="4">7</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="1" Grid.Row="2" Command="{Binding TypeValueCommand}"
                         CommandParameter="8" Margin="4">8</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="2" Grid.Row="2" Command="{Binding TypeValueCommand}"
                         CommandParameter="9" Margin="4">9</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="0" Grid.Row="3" Command="{Binding TypeValueCommand}"
                         CommandParameter="{Binding DecimalSeparator}" Margin="4" Content="{Binding DecimalSeparator}"/>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="1" Grid.Row="3" Command="{Binding TypeValueCommand}"
                         CommandParameter="0" Margin="4">0</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Grid.Column="2" Grid.Row="3" Command="{Binding SetValueCommand}"
                         CommandParameter="" Margin="4" ButtonColor="#334155">C</FxButton:FlexButton>
        </Grid>
        <UniformGrid Grid.Column="2" Rows="6">
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Margin="4" ButtonColor="#0F766E" Command="{Binding TenderAllCommand}"
                         Content="{Binding TenderAllCommand.Caption}" />
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Margin="4" ButtonColor="#164E63" Command="{Binding DivideValueCommand}"
                         CommandParameter="2" Foreground="WhiteSmoke">1/2</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Margin="4" ButtonColor="#164E63" Command="{Binding DivideValueCommand}"
                         CommandParameter="3" Foreground="WhiteSmoke">1/3</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Margin="4" ButtonColor="#164E63" Command="{Binding DivideValueCommand}"
                         CommandParameter="0" Foreground="WhiteSmoke">1/n</FxButton:FlexButton>
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Margin="4" ButtonColor="#0F766E" Command="{Binding ChangeBalanceModeCommand}"
                         Content="{Binding BalanceModeCaption}" />
            <FxButton:FlexButton Style="{StaticResource EboTouch}" Command="{Binding SetValueCommand}" CommandParameter="{Binding LastTenderedAmount}"
                         Margin="4" ButtonColor="#0F766E" Content="{Binding LastTenderedAmount}">
            </FxButton:FlexButton>
        </UniformGrid>
    </Grid>
</UserControl>
